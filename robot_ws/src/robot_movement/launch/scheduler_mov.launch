<launch>
    <node name="align_block" pkg="robot_vision" type="align_block.py" output="screen"/>
    <node name="search_block" pkg="robot_vision" type="search_block.py" output="screen"/>
    <node name="approach_table" pkg="robot_movement" type="approach_table.py" output="screen"/>
    <node name="border_detect" pkg="robot_movement" type="border_detect.py" output="screen"/>
    <node name="move_time" pkg="robot_movement" type="move_time.py" output="screen"/>
</launch>
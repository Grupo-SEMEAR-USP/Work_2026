<launch>
  <param name="robot_description" textfile="$(find robot_description)/urdf/robot_description.urdf" />

  <node name="base_footprint_tf" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 0 0 0 0 base_footprint base_link"/>

  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  
  </launch>
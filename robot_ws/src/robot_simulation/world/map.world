include "scout_mini.inc"

define floorplan model
(
  # sombre, sensible, artistic
  color "gray30"

  # most maps will need a bounding box
  boundary 1

  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  ranger_return 1
)

resolution 0.05 # Obtained from mapping process
interval_sim 100  # simulation timestep in milliseconds

window (
  size [ 800.0 500.0 ]
  center [ 0.0 0.0 ]
  rotate [ 0.0 0.0 ]
  scale 26 # Only to open full map based on ~30m size of floorplan
)

floorplan (
  name "map"
  bitmap "map.png" 
  size [ 30.9 17.75 2.0 ] # pixels * resolution
  pose [ 8.58 -4.125 0.0 0.0 ] # Yaml origin is in left bottom, this one is on the center
)

# throw in a robot
scout_mini (
  pose [ 0.0 0.0 0.0 0.0 ]
  name "scout_mini"
  color "black"
)

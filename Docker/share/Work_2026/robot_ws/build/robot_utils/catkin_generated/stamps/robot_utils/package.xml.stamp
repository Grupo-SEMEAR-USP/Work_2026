<?xml version="1.0"?>
<package format="2">
  <name>robot_utils</name>
  <version>0.0.0</version>
  <description>The robot_utils package</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <maintainer email="rmajetson@todo.todo">rmajetson</maintainer>

  <!-- One license tag required, multiple allowed, one license per tag -->
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  
  <exec_depend>robot_movement</exec_depend>
  <exec_depend>robot_communication</exec_depend>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>image_transport_plugins</exec_depend> 

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <!-- Other tools can request additional information be placed here -->

  </export>
</package>
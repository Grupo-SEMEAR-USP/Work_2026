<?xml version="1.0"?>
<package format="2">
  <name>robot_navigation</name>
  <version>0.0.0</version>
  <description>The robot_navigation package</description>

  <maintainer email="rmajetson@todo.todo">rmajetson</maintainer>

  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf</depend>
  
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>robot_communication</depend>

  <depend>move_base</depend>
  <depend>nav_core</depend>
  <depend>base_local_planner</depend> 
  <depend>costmap_2d</depend>
  <depend>map_server</depend>
  <depend>amcl</depend>
  
  <depend>pluginlib</depend>
  
  <exec_depend>rviz</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  
  <export>
    </export>
</package>
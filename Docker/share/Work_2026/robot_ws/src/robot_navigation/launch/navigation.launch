<launch>
  <arg name="map_file" default="$(find robot_navigation)/maps/lab_maker.yaml"/>
  <arg name="open_rviz" default="true"/>
  
  <arg name="output_type" default="screen"/>

  <node pkg="map_server" name="map_server" type="map_server" args="$(arg map_file)"/>

  <node pkg="amcl" type="amcl" name="amcl" output="$(arg output_type)">
    <rosparam file="$(find robot_navigation)/config/amcl_params.yaml" command="load" />
  </node>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="$(arg output_type)">
    <rosparam file="$(find robot_navigation)/config/move_base_params.yaml" command="load" />
    
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    
    <rosparam file="$(find robot_navigation)/config/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find robot_navigation)/config/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find robot_navigation)/config/costmap_local.yaml" command="load" />
    <rosparam file="$(find robot_navigation)/config/costmap_global.yaml" command="load" />
    <rosparam file="$(find robot_navigation)/config/planner_local_dwa.yaml" command="load" />
  </node>

  <node if="$(arg open_rviz)" pkg="rviz" type="rviz" name="rviz" 
        args="-d $(find robot_navigation)/rviz/navigation.rviz"/>
</launch>
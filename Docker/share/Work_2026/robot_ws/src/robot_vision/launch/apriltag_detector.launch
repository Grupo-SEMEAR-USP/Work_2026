<launch>
  <arg name="camera_name" default="usb_cam_logitech" />
  
  <node pkg="robot_vision" type="apriltag_detector.py" name="apriltag_detector" output="screen">
    
    <param name="camera_topic" value="/$(arg camera_name)/image_raw" />
    <param name="camera_info" value="/$(arg camera_name)/camera_info" />
    <param name="tag_family" value="tag36h11" />
    <param name="default_tag_size" value="0.035" />

    <param name="tag_decimate" value="1.5" /> 

    <rosparam command="load" file="$(find robot_vision)/config/tags.yaml" />
    
  </node>
</launch>